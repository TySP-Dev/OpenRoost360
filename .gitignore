data/
master.key
master.key.*
*.db
*.db-wal
*.db-shm
*.db.before-restore
SETUP-CODE.txt
wire.jsonl
wire.jsonl.*

# Encrypted backups and any private keys or certificates
*.orb
*.key
*.pem
*.crt
*.p12
*.pfx

# Docker settings (passwords, API keys) and bundled-service data
.env
.env.*
!.env.example
pihole/

