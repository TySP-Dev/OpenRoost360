*.apk
*.xapk
*.apks
apk/
apk-out/
decompiled/
index.android.bundle
out.js

# Research listener (roost_listen.py) runtime files
roost_log.jsonl
roost_log.jsonl.*
*.payload
*.payload.sent
files/
.serve.pids

# Flash dumps (planned): device-specific, possibly containing keys
*.bin
!roostfiles-certs/*.bin
dump*/
_*.extracted/

