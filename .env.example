# Copy to .env and adjust. Everything here is optional.

# Time zone for logs (the app's own time zone is set in Settings → Appearance)
TZ=America/Chicago

# Ports (host networking, so these are the server's ports). The hub's port 443 is redirected to the listener.
OPENROOST_HTTPS_PORT=8443
OPENROOST_HTTP_PORT=8362
OPENROOST_LISTENER_PORT=8883

# Extra host names you open OpenRoost by (besides IP addresses and *.local / *.lan / *.home.arpa).
# Needed for a domain name, e.g. behind Nginx Proxy Manager or for Authentik sign-in: openroost.example.com
OPENROOST_HOSTS=

# The hub's IP address (give it a DHCP reservation). OpenRoost keeps the hub's port 443 -> listener redirect
# (an iptables rule on this server) in place for it: at start-up, every minute, and after reboots or firewall reloads.
# Optional: you can also enter it in setup or Settings → Hub & network, and OpenRoost spots the hub in Pi-hole's
# query log by itself. Several addresses: comma-separated.
OPENROOST_HUB_IP=

# DNS server(s) OpenRoost uses for its own lookups (Matrix, email, Authentik, update check). Docker's host networking
# can't take a `dns:` setting, so set it here. Comma-separated IPs, optionally :port. "system" = the host's resolv.conf.
# Blank: OpenRoost's own Pi-hole when the "pihole" profile runs, else the host's resolv.conf. The host's resolver is
# always the fallback if these don't answer.
OPENROOST_DNS=

# HTTPS: "on" uses OpenRoost's own certificate (or OPENROOST_TLS_CERT / OPENROOST_TLS_KEY paths under /data).
# Behind Nginx Proxy Manager or another TLS proxy you may set OPENROOST_TLS=off and list the proxy's address:
OPENROOST_TLS=on
OPENROOST_PROXY_IPS=

# Reverse-engineering: 1 prints the protocol log (everything the hub sends/receives) to `docker compose logs -f openroost`.
# Also in the dashboard (Activity → Live protocol log) and optionally data/wire.jsonl (Settings → System).
OPENROOST_WIRE_STDOUT=0

# Only if the git repository is private: a read-only access token for the update check
OPENROOST_UPDATE_TOKEN=

# Use published images instead of building locally
# OPENROOST_IMAGE=git.tysstech.com/tyss-dev/openroost360:latest

# ---- Optional bundled services: list the ones you want, comma-separated ----
# COMPOSE_PROFILES=pihole,mailrelay
COMPOSE_PROFILES=

# Pi-hole (profile "pihole"). Skip if you already run one. Port 53 must be free on this server.
PIHOLE_PASSWORD=
PIHOLE_DNS_PORT=53
PIHOLE_WEB_PORT=8053
PIHOLE_UPSTREAMS=9.9.9.9;149.112.112.112

# Mail relay (profile "mailrelay"): hands OpenRoost's email to an SMTP service such as Resend.
RELAY_UPSTREAM=[smtp.resend.com]:587
RELAY_USERNAME=resend
RELAY_PASSWORD=
RELAY_SENDER_DOMAINS=example.com
RELAY_PORT=2525
